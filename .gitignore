# --- секреты -------------------------------------------------------------- #
.env
keys.local
*.key

# --- личные настройки ------------------------------------------------------ #
# В репозитории лежат только *.example.*: имена микрофонов и словарь терминов
# у каждого свои, а config.json ещё и перекрывает поведение целиком.
config.json
glossary.txt

# --- записи голоса --------------------------------------------------------- #
# Диктовки и ответы — это голос живого человека. В репозиторий они не попадают
# ни при каких условиях, даже как «удобные фикстуры».
_recordings/
_voice_samples/
tests/answer_*.wav

# --- расшифровки ----------------------------------------------------------- #
# То же самое, что записи, только текстом — и потому опаснее: содержимое ищется
# поиском и читается с одного взгляда. Здесь лежит всё продиктованное за месяц.
_transcripts/
_last_transcript.txt

# --- сгенерированное и тяжёлое --------------------------------------------- #
# Внимание: в .gitignore комментарий допустим ТОЛЬКО на отдельной строке. Хвост
# после паттерна становится частью паттерна, и правило молча перестаёт работать —
# так 63 МБ моделей Piper едва не уехали в репозиторий.
# ~63 МБ моделей Piper, качаются `python install.py --models`
tts_models/
__pycache__/
*.pyc
_daemon.log
_keepalive.log
_last_run.status
_recording.json
_recording.tmp
_daemon.off
_tray.ico
_test_tmp/
